generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // Плейсхолдер: схема требует URL с протоколом file: для provider = "sqlite",
  // но реальное подключение идёт через driver adapter (prisma.config.ts,
  // src/config/db.ts) на TURSO_DATABASE_URL — это значение не используется.
  url      = "file:./unused.db"
}

model User {
  id              Int      @id @default(autoincrement())
  telegramId      BigInt   @unique
  firstName       String?
  username        String?
  timezone        String? // IANA; null до онбординга
  defaultReminder Int      @default(30) // минуты; задел на итерацию 3
  isBlocked       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  accounts         CalendarAccount[] @relation("UserAccounts")
  defaultAccountId Int?
  defaultAccount   CalendarAccount?  @relation("UserDefaultAccount", fields: [defaultAccountId], references: [id], onDelete: SetNull)
  events           Event[]
  session          WizardSession?
}

// Только Google, но несколько аккаунтов (разных логинов) на пользователя —
// см. docs/features/04-multiple-google-accounts.md. googleAccountId — Google
// "sub", ключ дедупликации при повторном подключении; nullable для строк,
// созданных до этой фичи (identity ещё не запрашивался).
model CalendarAccount {
  id              Int     @id @default(autoincrement())
  userId          Int
  googleAccountId String? // Google "sub"; null у legacy-записей до реконнекта
  label           String // email аккаунта Google, напр. "user@gmail.com"
  externalId      String // calendarId, сейчас всегда "primary"

  accessToken  String? // зашифровано
  refreshToken String? // зашифровано
  expiresAt    DateTime?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  user       User    @relation("UserAccounts", fields: [userId], references: [id], onDelete: Cascade)
  defaultFor User[]  @relation("UserDefaultAccount")
  events     Event[]

  @@unique([userId, googleAccountId])
}

model Event {
  id              Int       @id @default(autoincrement())
  userId          Int
  accountId       Int
  externalId      String // ID события в календаре
  title           String
  description     String?
  allDay          Boolean
  startsAt        DateTime // UTC
  endsAt          DateTime? // UTC; null для all-day
  timezone        String
  reminderMinutes Int
  colorId         String? // Google's fixed "1".."11" (src/calendar/colors.ts); null = calendar's default color
  status          String   @default("ACTIVE") // "ACTIVE" | "DELETED"
  createdAt       DateTime @default(now())

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  account CalendarAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([userId, startsAt])
}

model WizardSession {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  state     String // JSON-строка: текущий шаг + собранные поля
  expiresAt DateTime
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OAuthState {
  state        String   @id // случайный nonce
  telegramId   BigInt
  expiresAt    DateTime
  resumeWizard Boolean  @default(false) // сгенерирован из середины /new — после подключения предложить «Продовжити»
}

// enum-ов нет: SQLite их не поддерживает.
// В коде (src/types/enums.ts):
//   export const EVENT_STATUSES = ['ACTIVE', 'DELETED'] as const;
//   export type EventStatus = typeof EVENT_STATUSES[number];
