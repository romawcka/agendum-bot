# Окружение процесса
NODE_ENV=development
PORT=3000
# Публичный URL сервера (нужен для OAuth-редиректов и вебхука Telegram)
BASE_URL=http://localhost:3000

# Токен бота от @BotFather
TELEGRAM_BOT_TOKEN=
# Секрет для проверки заголовка X-Telegram-Bot-Api-Secret-Token (только режим webhook)
TELEGRAM_WEBHOOK_SECRET=
# webhook | polling — локально используйте polling, в проде webhook
BOT_MODE=polling

# Путь к файлу SQLite, относительно каталога prisma/
DATABASE_URL=file:../data/app.db
BACKUP_DIR=./backups

# 32 байта в hex (64 символа), напр.: openssl rand -hex 32
ENCRYPTION_KEY=

# OAuth-приложение Google Calendar (console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/google/callback

# Telegram ID через запятую — кому разрешён доступ на закрытом этапе
ALLOWLIST_TELEGRAM_IDS=

DEFAULT_REMINDER_MINUTES=30
WIZARD_TTL_MINUTES=60
LOG_LEVEL=info
