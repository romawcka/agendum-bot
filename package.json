    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "googleapis": "^173.0.0",
    "grammy": "^1.45.1",
    "helmet": "^8.3.0",
    "ical-generator": "^11.0.0",
    "luxon": "^3.7.2",
    "pino": "^9.14.0",
    "tsdav": "^2.3.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/express": "^4.17.25",
    "@types/luxon": "^3.7.2",
    "@types/node": "^20.19.43",
    "@types/supertest": "^7.2.1",
    "prisma": "^6.19.3",
    "supertest": "^7.2.2",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
